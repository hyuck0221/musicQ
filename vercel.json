{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --workspace @musicq/web --include-workspace-root=false --include=dev",
  "buildCommand": "npm run build --workspace @musicq/web",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/downloads/musicq-server.tar.gz",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"musicq-server.tar.gz\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    }
  ]
}
