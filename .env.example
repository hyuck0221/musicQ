MUSICQ_HOST=127.0.0.1
MUSICQ_PORT=4310
MUSICQ_DATA_DIR=../../.musicq
# Built-in test synthesizer and managed MusicGen models are selected per job.
# Additional custom music model: executable and arguments, no shell
# MUSICQ_MODEL_COMMAND=["/absolute/path/python","/absolute/path/adapter.py"]
MUSICQ_MODEL_TIMEOUT=1800

# macOS model installs: Python 3.11/3.12 recommended
# MUSICQ_PYTHON=/opt/homebrew/bin/python3.12
MUSICQ_DEVICE=cpu

# Stable Audio 3: accept model/encoder terms on Hugging Face, then set a read token.
# HF_TOKEN=
